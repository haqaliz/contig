{"scenario_id": "flat-exact", "description": "flat claim with an exact observed match in a fresh results.json", "run_command": "python analysis.py", "claims": [{"id": "c1", "value": 42.0}], "executor_steps": [{"exit_code": 0, "write_results": {"c1": 42.0}}], "expected_claim_statuses": {"c1": "reproduced"}}
{"scenario_id": "flat-within-tolerance", "description": "flat claim whose observed value falls inside the relative tolerance band", "run_command": "python analysis.py", "claims": [{"id": "c1", "value": 10.0, "tolerance": 0.1}], "executor_steps": [{"exit_code": 0, "write_results": {"c1": 10.5}}], "expected_claim_statuses": {"c1": "within_tolerance"}}
{"scenario_id": "flat-diverged", "description": "flat claim whose observed value diverges far outside tolerance", "run_command": "python analysis.py", "claims": [{"id": "c1", "value": 10.0}], "executor_steps": [{"exit_code": 0, "write_results": {"c1": 25.0}}], "expected_claim_statuses": {"c1": "diverged"}}
{"scenario_id": "flat-non-finite", "description": "flat claim whose observed value is a non-numeric JSON string -- never diverged, always unverified", "run_command": "python analysis.py", "claims": [{"id": "c1", "value": 10.0}], "executor_steps": [{"exit_code": 0, "write_results": {"c1": "not_a_number"}}], "expected_claim_statuses": {"c1": "unverified"}}
{"scenario_id": "json-locator", "description": "a Locator claim binding a number out of a fresh metrics.json", "run_command": "python analysis.py", "claims": [{"id": "c1", "value": 30.0, "from": "metrics.json", "path": "$.qc.median_depth"}], "executor_steps": [{"exit_code": 0, "write_artifacts": {"metrics.json": "{\"qc\": {\"median_depth\": 30.0}}"}}], "expected_claim_statuses": {"c1": "reproduced"}}
{"scenario_id": "table-locator", "description": "a TableLocator claim reading one TSV cell within tolerance", "run_command": "python analysis.py", "claims": [{"id": "c1", "value": -0.4, "tolerance": 0.1, "from": "de.tsv", "column": "log2FoldChange", "row": {"gene": "TP53"}}], "executor_steps": [{"exit_code": 0, "write_artifacts": {"de.tsv": "gene\tlog2FoldChange\nTP53\t-0.42\n"}}], "expected_claim_statuses": {"c1": "within_tolerance"}}
{"scenario_id": "pattern-file", "description": "a file-mode PatternLocator capturing the observed value from a fresh run.log", "run_command": "python analysis.py", "claims": [{"id": "c1", "value": 0.912, "from": "run.log", "pattern": "AUROC=([0-9.]+)"}], "executor_steps": [{"exit_code": 0, "write_artifacts": {"run.log": "AUROC=0.912\n"}}], "expected_claim_statuses": {"c1": "reproduced"}}
{"scenario_id": "pattern-stdout", "description": "a stdout-mode PatternLocator binding the run's own captured output (exempt from freshness)", "run_command": "python analysis.py", "claims": [{"id": "c1", "value": 0.912, "pattern": "AUROC=([0-9.]+)"}], "executor_steps": [{"exit_code": 0, "output": "AUROC=0.912\n"}], "expected_claim_statuses": {"c1": "reproduced"}}
{"scenario_id": "notebook-locator", "description": "a NotebookLocator claim binding the cell output of a fresh analysis.ipynb", "run_command": "python analysis.py", "claims": [{"id": "c1", "value": 0.912, "from": "analysis.ipynb", "cell": {"contains": "print(auroc)"}, "pattern": "([0-9.]+)"}], "executor_steps": [{"exit_code": 0, "write_artifacts": {"analysis.ipynb": "{\"cells\": [{\"cell_type\": \"code\", \"source\": [\"print(auroc)\"], \"outputs\": [{\"output_type\": \"execute_result\", \"data\": {\"text/plain\": [\"0.912\"]}}]}]}"}}], "expected_claim_statuses": {"c1": "reproduced"}}
{"scenario_id": "stale-artifact", "description": "flat claim whose results.json predates the run start -- the real freshness guard fires, never a false pass", "run_command": "python analysis.py", "claims": [{"id": "c1", "value": 42.0}], "executor_steps": [{"exit_code": 0, "write_results": {"c1": 42.0}, "artifact_mtimes": {"results.json": 999999.0}}], "expected_claim_statuses": {"c1": "unverified"}}
{"scenario_id": "env-resurrection-heal", "description": "missing pandas detected, installed (rc 0), one retry writes fresh results -- reproduced + installed_and_retried", "run_command": "python analysis.py", "claims": [{"id": "c1", "value": 42.0}], "allow_install": true, "executor_steps": [{"exit_code": 1, "output": "Traceback (most recent call last):\nModuleNotFoundError: No module named 'pandas'\n"}, {"exit_code": 0, "write_results": {"c1": 42.0}}], "installer_steps": [0], "expected_claim_statuses": {"c1": "reproduced"}, "expected_repair": "installed_and_retried"}
{"scenario_id": "install-fail-giveup", "description": "missing numpy; install fails (rc 1) -- one bounded attempt, then honest unverified + install_failed", "run_command": "python analysis.py", "claims": [{"id": "c1", "value": 42.0}], "allow_install": true, "executor_steps": [{"exit_code": 1, "output": "ModuleNotFoundError: No module named 'numpy'\n"}], "installer_steps": [1], "expected_claim_statuses": {"c1": "unverified"}, "expected_repair": "install_failed", "expected_exit_code": 1}
{"scenario_id": "nonzero-exit", "description": "the run exits 5 with no install allowed -- every claim unverified, no repair", "run_command": "python analysis.py", "claims": [{"id": "c1", "value": 42.0}], "executor_steps": [{"exit_code": 5, "output": "boom"}], "expected_claim_statuses": {"c1": "unverified"}, "expected_repair": "none", "expected_exit_code": 5}
{"scenario_id": "known-miss", "description": "deliberate wrong expectation (would classify reproduced) keeping the committed baseline < 1.0", "run_command": "python analysis.py", "claims": [{"id": "c1", "value": 42.0}], "executor_steps": [{"exit_code": 0, "write_results": {"c1": 42.0}}], "expected_claim_statuses": {"c1": "diverged"}, "known_miss": true}
{"scenario_id": "env-alias-map-heal", "description": "cv2 import resolved to opencv-python; installed (rc 0), one retry writes fresh results -- reproduced + installed_and_retried", "run_command": "python run.py", "claims": [{"id": "claim-1", "value": 42.0}], "allow_install": true, "executor_steps": [{"exit_code": 1, "output": "ModuleNotFoundError: No module named 'cv2'\n"}, {"exit_code": 0, "write_results": {"claim-1": 42.0}}], "installer_steps": [0], "installer_expected_argv": [["<sys.executable>", "-m", "pip", "install", "opencv-python"]], "expected_claim_statuses": {"claim-1": "reproduced"}, "expected_repair": "installed_and_retried"}
{"scenario_id": "env-two-install-heal", "description": "two missing modules chased in two installs (cv2->opencv-python, sklearn->scikit-learn); retries write fresh results -- reproduced + installed_and_retried", "run_command": "python run.py", "claims": [{"id": "claim-1", "value": 42.0}], "allow_install": true, "executor_steps": [{"exit_code": 1, "output": "ModuleNotFoundError: No module named 'cv2'\n"}, {"exit_code": 1, "output": "ModuleNotFoundError: No module named 'sklearn'\n"}, {"exit_code": 0, "write_results": {"claim-1": 42.0}}], "installer_steps": [0, 0], "installer_expected_argv": [["<sys.executable>", "-m", "pip", "install", "opencv-python"], ["<sys.executable>", "-m", "pip", "install", "scikit-learn"]], "expected_claim_statuses": {"claim-1": "reproduced"}, "expected_repair": "installed_and_retried"}
{"scenario_id": "env-second-install-fail-giveup", "description": "first install succeeds, second install fails (rc 1) -- bounded give-up, install_failed, honest unverified", "run_command": "python run.py", "claims": [{"id": "claim-1", "value": 42.0}], "allow_install": true, "executor_steps": [{"exit_code": 1, "output": "ModuleNotFoundError: No module named 'cv2'\n"}, {"exit_code": 1, "output": "ModuleNotFoundError: No module named 'sklearn'\n"}], "installer_steps": [0, 1], "expected_claim_statuses": {"claim-1": "unverified"}, "expected_repair": "install_failed", "expected_exit_code": 1}
